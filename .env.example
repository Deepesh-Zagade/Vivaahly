# MongoDB Atlas development connection. Use separate databases for local,
# preview/staging, test, and production environments.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=vivaahly_dev
# Optional comma-separated DNS resolvers for local environments where Node's
# default resolver cannot query MongoDB Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Keep the native driver's normal recovery window for cold Atlas connections.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000

# Never prefix secrets with NEXT_PUBLIC_.

# Public application origin used to generate organizer invitation links.
APP_BASE_URL=http://localhost:3000

# Transactional organizer invitation email delivery through Resend.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Vivaahly <invitations@your-verified-domain.example>

# Optional dashboard fixture. Local development shows the approved Stitch
# preview automatically; set this only when a non-local environment explicitly
# needs the same clearly-labelled preview data.
# DASHBOARD_DEMO_DATA=false
